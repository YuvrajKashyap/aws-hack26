# Reference only: this file is not automatically loaded. No credentials belong here.
DEMO_MODE=offline
DEMO_LEDGER_PATH=data/demo.sqlite
# Only set bedrock after separately authorized account integration.
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
BEDROCK_CONNECT_TIMEOUT=3
BEDROCK_READ_TIMEOUT=10
BEDROCK_INTERVAL_SECONDS=2
BEDROCK_MAX_ATTEMPTS=2
# A single designated process must own inference across teammates.
BEDROCK_SINGLE_PROCESS_ACK=false
